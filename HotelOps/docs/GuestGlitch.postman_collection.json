{
  "info": { "name": "HotelOps Guest Glitch", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{AuthToken}}", "type": "string" }] },
  "variable": [
    { "key": "LocalUrl", "value": "http://localhost:3000/api" },
    { "key": "AuthToken", "value": "" },
    { "key": "GuestGlitchID", "value": "1" }
  ],
  "item": [
    { "name": "Create Guest Glitch", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [
      { "key": "OrganizationID", "value": "30", "type": "text" }, { "key": "GuestStatus", "value": "In House", "type": "text" },
      { "key": "RoomNumber", "value": "101", "type": "text" }, { "key": "GuestName", "value": "Rohit Sharma", "type": "text" },
      { "key": "Complaint", "value": "Air conditioning is not cooling properly.", "type": "text" },
      { "key": "DepartmentIDs", "value": "[10]", "type": "text" }, { "key": "ReceivedByIDs", "value": "[3]", "type": "text" },
      { "key": "InformedToIDs", "value": "[4]", "type": "text" }, { "key": "Time", "value": "14:30", "type": "text" },
      { "key": "CompanyName", "value": "ABC Limited", "type": "text" }, { "key": "Attachment", "type": "file", "src": [] }
    ] }, "url": "{{LocalUrl}}/GuestGlitch/create" } },
    { "name": "List Guest Glitches", "request": { "method": "GET", "url": "{{LocalUrl}}/GuestGlitch/list?organizationId=30&fromDate=2026-08-01&toDate=2026-08-25&status=Open&search=air&page=1&pageSize=10" } },
    { "name": "Guest Glitch Detail", "request": { "method": "GET", "url": "{{LocalUrl}}/GuestGlitch/{{GuestGlitchID}}" } },
    { "name": "Compact Report", "request": { "method": "GET", "url": "{{LocalUrl}}/GuestGlitch/report?page=1&pageSize=10&sortBy=EntryDate&sortDirection=DESC" } },
    { "name": "Report Detail", "request": { "method": "GET", "url": "{{LocalUrl}}/GuestGlitch/report/{{GuestGlitchID}}" } },
    { "name": "Master Report", "request": { "method": "GET", "url": "{{LocalUrl}}/GuestGlitch/master-report?page=1&pageSize=10" } },
    { "name": "Master Report PDF", "request": { "method": "GET", "url": "{{LocalUrl}}/GuestGlitch/master-report/{{GuestGlitchID}}/pdf" } },
    { "name": "Deprecated - GM View", "request": { "method": "GET", "url": "{{LocalUrl}}/GuestGlitch/gm/{{GuestGlitchID}}" } },
    { "name": "Deprecated - GM Action", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"ID\": {{GuestGlitchID}},\n  \"GMComment\": \"Reviewed by configured actor\"\n}" }, "url": "{{LocalUrl}}/GuestGlitch/gm-action" } },
    { "name": "View Attachment", "request": { "method": "GET", "url": "{{LocalUrl}}/GuestGlitch/attachment/{{GuestGlitchID}}?disposition=inline" } },
    { "name": "Download Attachment", "request": { "method": "GET", "url": "{{LocalUrl}}/GuestGlitch/attachment/{{GuestGlitchID}}?disposition=attachment" } },
    { "name": "Export Report CSV", "request": { "method": "GET", "url": "{{LocalUrl}}/GuestGlitch/report/export/csv?status=Open&fromDate=2026-08-01&toDate=2026-08-31" } },
    { "name": "Export Report Excel", "request": { "method": "GET", "url": "{{LocalUrl}}/GuestGlitch/report/export/excel?status=Open&fromDate=2026-08-01&toDate=2026-08-31" } }
  ]
}
